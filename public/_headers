# Static-host header rules. Read natively by Netlify and Cloudflare Pages.
# Other hosts ignore this file — see README "Deploying" for nginx/Apache equivalents.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; base-uri 'self'; form-action 'self' https://wa.me mailto:; object-src 'none'; frame-ancestors 'self'; frame-src 'self' https://www.google.com https://maps.google.com https://wa.me
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800
