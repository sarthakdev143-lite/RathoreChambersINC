---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  items: readonly { icon: string; title: string; body: string }[];
  /** Column count at the widest breakpoint. */
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<ul class="features" data-columns={columns}>
  {
    items.map((item, index) => (
      <li
        class="card card--interactive reveal"
        style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}
      >
        <span class="card-icon">
          <Icon name={item.icon as IconName} size={20} />
        </span>
        <h3 class="card__title">{item.title}</h3>
        <p class="card__body">{item.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 620px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .features[data-columns='3'] {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
