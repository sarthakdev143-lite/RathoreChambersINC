---
import EnquiryForm from './EnquiryForm.astro';
import Icon from './Icon.astro';

import { CONTACT, whatsappLink } from '../config/site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  body: string;
  defaultType?: 'agricultural' | 'commercial' | 'it';
}

const { locale, title, body, defaultType } = Astro.props;
const t = ui[locale];
---

<section class="section enquiry-section">
  <div class="container enquiry-section__inner">
    <div class="enquiry-section__aside reveal">
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h2 class="h2">{title}</h2>
      <p class="lede enquiry-section__body">{body}</p>

      <ul class="direct">
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />
            <span>
              <strong>{t.contact.whatsappCard.title}</strong>
              {CONTACT.phone.display}
            </span>
            <Icon name="arrow-up-right" size={16} class="direct__go" />
          </a>
        </li>
        <li>
          <a href={`tel:${CONTACT.phone.e164}`}>
            <Icon name="phone" size={18} />
            <span>
              <strong>{t.contact.phoneCard.title}</strong>
              {CONTACT.phone.display}
            </span>
            <Icon name="arrow-up-right" size={16} class="direct__go" />
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`}>
            <Icon name="mail" size={18} />
            <span>
              <strong>{t.contact.emailCard.title}</strong>
              {CONTACT.email}
            </span>
            <Icon name="arrow-up-right" size={16} class="direct__go" />
          </a>
        </li>
      </ul>

      <p class="response">
        <Icon name="clock" size={14} />
        {t.common.responseTime}
      </p>
    </div>

    <div class="enquiry-section__form reveal" style="--reveal-delay:100ms">
      <EnquiryForm locale={locale} defaultType={defaultType} />
    </div>
  </div>
</section>

<style>
  .enquiry-section {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }

  .enquiry-section__inner {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .enquiry-section__inner {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .enquiry-section__aside .eyebrow {
    margin-bottom: 1rem;
  }

  .enquiry-section__body {
    margin-top: 1rem;
  }

  .direct {
    display: grid;
    gap: 0.6rem;
    margin-top: 2rem;
    list-style: none;
    padding: 0;
  }

  .direct a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .direct a:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .direct a > :global(svg:first-child) {
    color: var(--accent);
  }

  .direct strong {
    display: block;
    color: var(--fg);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .direct :global(.direct__go) {
    color: var(--fg-subtle);
  }

  .response {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
  }
</style>
