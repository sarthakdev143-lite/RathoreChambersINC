---
import Icon from './Icon.astro';

import { whatsappLink } from '../config/site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<a
  class="fab"
  id="wa-fab"
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.common.whatsapp}
>
  <Icon name="whatsapp" size={26} />
  <span class="fab__label">{t.common.whatsapp}</span>
</a>

<script>
  // Reveal once the visitor has engaged with the page, so it never covers the
  // hero call-to-action on first paint.
  const fab = document.getElementById('wa-fab');

  if (fab) {
    const onScroll = () => fab.classList.toggle('is-shown', window.scrollY > 400);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;

    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem;
    border-radius: var(--radius-pill);

    background: #25d366;
    color: #052e16;
    text-decoration: none;
    box-shadow:
      0 8px 30px -6px rgb(37 211 102 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.15);

    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease),
      visibility 0.3s,
      box-shadow 0.3s var(--ease);
  }

  .fab.is-shown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .fab:hover {
    box-shadow:
      0 12px 38px -6px rgb(37 211 102 / 0.6),
      0 2px 8px rgb(0 0 0 / 0.2);
  }

  .fab__label {
    font-size: var(--fs-sm);
    font-weight: 600;
    padding-right: 0.4rem;
  }

  /* Collapse to a circle where horizontal space is scarce. */
  @media (max-width: 560px) {
    .fab__label {
      display: none;
    }
  }
</style>
