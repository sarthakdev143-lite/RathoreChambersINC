---
/**
 * Inline SVG icon set. No runtime, no icon-font, no extra requests.
 * Stroke icons share a 24×24 grid; brand marks are filled.
 */
export type IconName =
  | 'shield'
  | 'scales'
  | 'network'
  | 'handshake'
  | 'document'
  | 'user'
  | 'clock'
  | 'lock'
  | 'field'
  | 'shop'
  | 'search'
  | 'key'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'chevron-down'
  | 'menu'
  | 'close'
  | 'globe'
  | 'check'
  | 'whatsapp'
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'youtube'
  | 'x';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const FILLED: IconName[] = ['whatsapp', 'facebook', 'instagram', 'linkedin', 'youtube', 'x'];
const isFilled = FILLED.includes(name);
---

<svg
