---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  /** Heading level used for each question, so page outlines stay correct. */
  class?: string;
}

const { items, class: className } = Astro.props;
---

{/* Native <details> — keyboard accessible, searchable by the browser, zero JS. */}
<div class={`faq ${className ?? ''}`}>
  {
    items.map((item, index) => (
      <details class="faq__item reveal" style={`--reveal-delay:${Math.min(index, 5) * 50}ms`}>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="chevron-down" size={18} />
          </span>
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .faq__item[open] {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem clamp(1rem, 2vw, 1.5rem);
    font-family: var(--ff-display);
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--accent);
  }

  .faq__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transition: transform 0.25s var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  .faq__a {
    padding: 0 clamp(1rem, 2vw, 1.5rem) 1.35rem;
  }

  .faq__a p {
    max-width: 72ch;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a {
      animation: faq-open 0.28s var(--ease);
    }

    @keyframes faq-open {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }
</style>
