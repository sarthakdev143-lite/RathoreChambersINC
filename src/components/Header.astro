---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

import { whatsappLink } from '../config/site';
import { ui } from '../i18n/ui';
import {
  LOCALES,
  LOCALE_NAMES,
  LOCALE_SHORT,
  ROUTES,
  localePath,
  route,
  type Locale,
  type RouteKey,
} from '../i18n/utils';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const t = ui[locale];

const servicesKeys: RouteKey[] = ['services', 'agriculturalLand', 'commercialShops', 'itStaffing'];

const links: { key: RouteKey; label: string; children?: { key: RouteKey; label: string }[] }[] = [
  { key: 'home', label: t.nav.home },
  {
    key: 'services',
    label: t.nav.services,
    children: [
      { key: 'agriculturalLand', label: t.nav.agriculturalLand },
      { key: 'commercialShops', label: t.nav.commercialShops },
      { key: 'itStaffing', label: t.nav.itStaffing },
    ],
  },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];

const submenuIcon: Record<string, 'field' | 'shop' | 'code'> = {
  agriculturalLand: 'field',
  commercialShops: 'shop',
  itStaffing: 'code',
};

const isActive = (key: RouteKey) =>
  key === 'services' ? servicesKeys.includes(routeKey) : routeKey === key;
---

<header class="site-header" id="site-header">
  <div class="site-header__inner container">
    <a class="brand" href={route(locale, 'home')} aria-label={t.brand.name}>
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">Rathore Chambers <span class="brand__inc">INC</span></span>
        <span class="brand__tagline">{t.brand.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t.nav.menu}>
      <ul class="nav__list">
        {
          links.map((link) => (
            <li class={link.children ? 'nav__item nav__item--has-menu' : 'nav__item'}>
              <a
                class="nav__link"
                href={route(locale, link.key)}
                aria-current={isActive(link.key) ? 'page' : undefined}
                data-active={isActive(link.key) ? 'true' : undefined}
              >
                {link.label}
                {link.children && <Icon name="chevron-down" size={14} class="nav__caret" />}
              </a>

              {link.children && (
                <div class="submenu">
                  <ul class="submenu__list">
                    {link.children.map((child) => (
                      <li>
                        <a class="submenu__link" href={route(locale, child.key)}>
                          <Icon name={submenuIcon[child.key] ?? 'shop'} size={18} />
                          <span>{child.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <div class="lang" role="group" aria-label={t.common.languageLabel}>
        {
          LOCALES.map((l) => (
            <a
              class="lang__option"
              href={localePath(l, ROUTES[routeKey])}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? 'true' : undefined}
              data-current={l === locale ? 'true' : undefined}
            >
              <span aria-hidden="true">{LOCALE_SHORT[l]}</span>
              <span class="visually-hidden">{LOCALE_NAMES[l]}</span>
            </a>
          ))
        }
      </div>

      <a
        class="btn btn--primary header-cta"
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" size={17} />
        {t.common.whatsapp}
      </a>

      <button
        type="button"
        class="burger"
        id="burger"
        aria-label={t.nav.openMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={22} class="burger__open" />
        <Icon name="close" size={22} class="burger__close" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu surface-dark" id="mobile-menu" hidden>
  <nav class="mobile-menu__inner container" aria-label={t.nav.menu}>
    <ul class="mobile-menu__list">
      {
        links.map((link) => (
          <li>
            <a
              class="mobile-menu__link"
              href={route(locale, link.key)}
              aria-current={isActive(link.key) ? 'page' : undefined}
            >
              {link.label}
              <Icon name="arrow-up-right" size={18} />
            </a>
            {link.children && (
              <ul class="mobile-menu__sublist">
                {link.children.map((child) => (
                  <li>
                    <a class="mobile-menu__sublink" href={route(locale, child.key)}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <a
      class="btn btn--wa btn--lg btn--block"
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="whatsapp" size={19} />
      {t.common.whatsapp}
    </a>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  // Solidify the header once the hero has scrolled away.
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Close on Escape, and whenever a destination is chosen.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Reset if the viewport grows past the mobile breakpoint while open.
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    color: var(--c-cream-50);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: rgb(251 250 247 / 0.82);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    backdrop-filter: saturate(180%) blur(14px);
    color: var(--c-ink-900);
    border-bottom-color: rgb(10 19 16 / 0.08);
    box-shadow: 0 1px 20px -8px rgb(10 19 16 / 0.25);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  /* ---------------------------------------------------------------- brand */

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex: none;
  }

  .brand :global(.brand__mark) {
    width: 34px;
    height: 34px;
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand__inc {
    color: var(--c-gold-500);
  }

  .brand__tagline {
    font-family: var(--ff-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.62;
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    .brand__tagline {
      display: none;
    }
  }

  /* ------------------------------------------------------------ desktop nav */

  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.82;
    transition:
      opacity 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .nav__link:hover,
  .nav__link[data-active] {
    opacity: 1;
    background: currentColor;
  }

  /* Keeps the label readable against the `currentColor` pill above. */
  .nav__link:hover,
  .nav__link[data-active] {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .nav__link :global(.nav__caret) {
    opacity: 0.6;
    transition: transform 0.2s var(--ease);
  }

  .nav__item--has-menu:hover :global(.nav__caret),
  .nav__item--has-menu:focus-within :global(.nav__caret) {
    transform: rotate(180deg);
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 16rem;
    padding: 0.4rem;
    background: var(--c-cream-50);
    color: var(--c-ink-900);
    border: 1px solid rgb(10 19 16 / 0.1);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease),
      visibility 0.2s;
  }

  .nav__item--has-menu:hover .submenu,
  .nav__item--has-menu:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .submenu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .submenu__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.8rem;
    border-radius: 10px;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--c-ink-900);
    transition: background-color 0.15s var(--ease);
  }

  .submenu__link :global(svg) {
    color: var(--c-forest-500);
  }

  .submenu__link:hover {
    background: rgb(10 19 16 / 0.05);
  }

  /* -------------------------------------------------------------- actions */

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .lang {
    display: flex;
    align-items: center;
    padding: 2px;
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
    border-radius: var(--radius-pill);
  }

  .lang__option {
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    opacity: 0.7;
    transition:
      background-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }

  .lang__option:hover {
    opacity: 1;
  }

  .lang__option[data-current] {
    background: color-mix(in srgb, currentColor 16%, transparent);
    opacity: 1;
  }

  .header-cta {
    display: none;
  }

  .site-header:not(.is-scrolled) .header-cta {
    background: var(--c-gold-500);
    color: var(--c-ink-900);
  }

  .site-header:not(.is-scrolled) .header-cta:hover {
    background: var(--c-gold-400);
  }

  .burger {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
  }

  .burger :global(.burger__close) {
    display: none;
  }

  .burger[aria-expanded='true'] :global(.burger__open) {
    display: none;
  }

  .burger[aria-expanded='true'] :global(.burger__close) {
    display: block;
  }

  @media (min-width: 1000px) {
    .nav,
    .header-cta {
      display: flex;
    }

    .burger {
      display: none;
    }
  }

  /* ---------------------------------------------------------- mobile menu */

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 99;
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: menu-in 0.25s var(--ease);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2rem 3rem;
  }

  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__list > li + li {
    border-top: 1px solid var(--border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0 0.75rem;
    font-family: var(--ff-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--fg);
  }

  .mobile-menu__link :global(svg) {
    color: var(--c-gold-400);
    opacity: 0.75;
  }

  .mobile-menu__sublist {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0 0 0 0.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mobile-menu__sublink {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .mobile-menu__sublink:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
</style>
