---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Icon, { type IconName } from '../../components/Icon.astro';

import { STATS } from '../../config/site';
import { ui } from '../../i18n/ui';
import { localePaths, route, type Locale, type RouteKey } from '../../i18n/utils';
import { faqSchema } from '../../lib/seo';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={t.meta.home.title}
  fullTitle={`${t.brand.name} — ${t.meta.home.title}`}
  description={t.meta.home.description}
  schema={[faqSchema(t.faq)]}
>
  {/* ───────────────────────────────────────────────────────────────  hero */}
  <section class="hero surface-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="glow glow--green" aria-hidden="true"></div>
    <div class="glow glow--gold" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">{t.home.eyebrow}</p>

        <h1 class="hero__title">
          {t.home.h1Lead}<br /><span class="hero__accent">{t.home.h1Accent}</span>
        </h1>

        <p class="lede hero__lede">{t.home.sub}</p>

        <div class="hero__actions">
          <a class="btn btn--lg hero__cta" href={route(locale, 'contact')}>
            {t.home.primaryCta}
            <Icon name="arrow-right" size={17} />
          </a>
          <a class="btn btn--outline btn--lg" href={route(locale, 'services')}>
            {t.home.secondaryCta}
          </a>
        </div>

        <ul class="hero__trust">
          {
            t.home.trust.map((item) => (
              <li>
                <Icon name="check" size={14} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Verification panel — makes the "we check the paper" promise concrete. */}
      <aside class="panel" aria-label={t.home.panel.title}>
        <div class="panel__head">
          <span class="panel__label">{t.home.panel.label}</span>
          <span class="panel__dot" aria-hidden="true"></span>
        </div>

        <h2 class="panel__title">{t.home.panel.title}</h2>

        <ul class="panel__rows">
          {
            t.home.panel.rows.map((row) => (
              <li class="panel__row">
                <span class="panel__name">{row.name}</span>
                <span class="panel__status">
                  <Icon name="check" size={12} />
                  {row.status}
                </span>
              </li>
            ))
          }
        </ul>

        <p class="panel__foot">{t.home.panel.footnote}</p>
      </aside>
    </div>
  </section>

  {/* ──────────────────────────────────────────────────────────────  stats */}
  {
    STATS.length > 0 && (
      <section class="stats-strip">
        <div class="container">
          <dl class="stats">
            {STATS.map((stat) => (
              <div class="stat">
                <dt class="stat__label">{t.home.statLabels[stat.key]}</dt>
                <dd class="stat__value">{stat.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {/* ───────────────────────────────────────────────────────────  services */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.home.servicesEyebrow}</p>
        <h2 class="h2">{t.home.servicesTitle}</h2>
        <p class="lede">{t.home.servicesSub}</p>
      </div>

      <div class="service-cards">
        {
          [...t.services.items]
            .sort((a, b) => ['itStaffing', 'agriculturalLand', 'commercialShops'].indexOf(a.key) - ['itStaffing', 'agriculturalLand', 'commercialShops'].indexOf(b.key))
            .map((item, index) => (
            <article
              class="service-card reveal"
              style={`--reveal-delay:${index * 80}ms`}
            >
              <div class="service-card__top">
                <span class="card-icon">
                  <Icon name={item.icon as IconName} size={22} />
                </span>
                <span class="service-card__native deva">{item.native}</span>
              </div>

              <h3 class="service-card__title">{item.title}</h3>
              <p class="card__body">{item.summary}</p>

              <ul class="checklist service-card__list">
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <a class="link-arrow service-card__link" href={route(locale, item.key as RouteKey)}>
                {t.common.learnMore}
                <Icon name="arrow-right" size={15} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ────────────────────────────────────────────────────────────────  why */}
  <section class="section section--tight why">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.home.whyEyebrow}</p>
        <h2 class="h2">{t.home.whyTitle}</h2>
        <p class="lede">{t.home.whySub}</p>
      </div>

      <FeatureGrid items={t.home.why} />
    </div>
  </section>

  {/* ────────────────────────────────────────────────────────────  process */}
  <section class="section surface-dark process">
    <div class="grid-lines" aria-hidden="true"></div>

    <div class="container process__inner">
      <div class="section-head">
        <p class="eyebrow">{t.home.processEyebrow}</p>
        <h2 class="h2">{t.home.processTitle}</h2>
        <p class="lede">{t.home.processSub}</p>
      </div>

      <ol class="steps">
        {
          t.home.process.map((step, index) => (
            <li class="step reveal" style={`--reveal-delay:${index * 70}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ────────────────────────────────────────────────────────────────  faq */}
  <section class="section">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">{t.home.faqEyebrow}</p>
        <h2 class="h2">{t.home.faqTitle}</h2>
      </div>

      <FAQAccordion items={t.faq} />
    </div>
  </section>

  <CTABand
    locale={locale}
    title={t.home.ctaTitle}
    body={t.home.ctaBody}
    waMessage={t.form.waIntro}
  />
</BaseLayout>

<style>
  /* ────────────────────────────────────────────────────────────────  hero */

  .hero {
    position: relative;
    overflow: hidden;
  }

  .glow--green {
    width: 48rem;
    height: 32rem;
    top: -16rem;
    left: -12rem;
    background: radial-gradient(circle, rgb(46 139 107 / 0.42), transparent 68%);
  }

  .glow--gold {
    width: 34rem;
    height: 24rem;
    right: -10rem;
    bottom: -12rem;
    background: radial-gradient(circle, rgb(201 162 39 / 0.22), transparent 70%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 10vw, 7.5rem);
  }

  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1.35fr 1fr;
      align-items: center;
    }
  }

  .hero__title {
    margin-top: 1.5rem;
    font-size: var(--fs-5xl);
  }

  .hero__accent {
    color: var(--c-gold-400);
  }

  .hero__lede {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Gold primary reads better than green against the dark hero. */
  .hero__cta {
    background: var(--c-gold-500);
    color: var(--c-ink-900);
    box-shadow: 0 10px 34px -10px rgb(201 162 39 / 0.65);
  }

  .hero__cta:hover {
    background: var(--c-gold-400);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .hero__trust :global(svg) {
    color: var(--c-forest-300);
    flex: none;
  }

  /* ───────────────────────────────────────────────────  verification panel */

  .panel {
    padding: 1.5rem;
    background: rgb(251 250 247 / 0.045);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
  }

  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .panel__label {
    font-family: var(--ff-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .panel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-forest-300);
    box-shadow: 0 0 0 4px rgb(86 179 145 / 0.18);
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel__dot {
      animation: pulse 2.6s var(--ease) infinite;
    }

    @keyframes pulse {
      0%,
      100% {
        box-shadow: 0 0 0 4px rgb(86 179 145 / 0.18);
      }
      50% {
        box-shadow: 0 0 0 8px rgb(86 179 145 / 0.05);
      }
    }
  }

  .panel__title {
    margin-top: 0.5rem;
    font-size: var(--fs-xl);
  }

  .panel__rows {
    margin-top: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .panel__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px dashed var(--border);
    font-size: var(--fs-sm);
  }

  .panel__row:first-child {
    border-top: none;
  }

  .panel__name {
    color: var(--fg-muted);
  }

  .panel__status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgb(86 179 145 / 0.14);
    border: 1px solid rgb(86 179 145 / 0.28);
    color: var(--c-forest-200);
    font-family: var(--ff-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .panel__foot {
    margin-top: 1.25rem;
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
    line-height: 1.55;
  }

  /* ───────────────────────────────────────────────────────────────  stats */

  .stats-strip {
    background: var(--c-ink-850);
    color: var(--c-cream-50);
    border-block: 1px solid rgb(251 250 247 / 0.08);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    background: rgb(251 250 247 / 0.08);
  }

  @media (min-width: 780px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
    background: var(--c-ink-850);
    text-align: center;
  }

  .stat__value {
    margin: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--c-gold-400);
  }

  .stat__label {
    font-size: var(--fs-xs);
    color: rgb(251 250 247 / 0.6);
  }

  /* ────────────────────────────────────────────────────────────  services */

  .service-cards {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .service-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
  }

  .service-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .service-card__top .card-icon {
    margin-bottom: 0;
    width: 3rem;
    height: 3rem;
  }

  .service-card__native {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--gold);
  }

  .service-card__title {
    font-size: var(--fs-2xl);
    margin-bottom: 0.6rem;
  }

  .service-card__list {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .service-card__link {
    margin-top: auto;
    padding-top: 1.75rem;
    align-self: flex-start;
  }

  /* ─────────────────────────────────────────────────────────────────  why */

  .why {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }

  /* ─────────────────────────────────────────────────────────────  process */

  .process {
    position: relative;
    overflow: hidden;
  }

  .process__inner {
    position: relative;
    z-index: 1;
  }

  .steps {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
  }

  .step {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .step:first-child {
    border-top: none;
  }

  @media (min-width: 900px) {
    .step {
      flex-direction: column;
      gap: 1rem;
      padding: 2rem 1.5rem;
      border-top: none;
      background: var(--bg);
    }
  }

  .step__num {
    flex: none;
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-gold-400);
    padding-top: 0.15rem;
  }

  .step__title {
    font-size: var(--fs-base);
    margin-bottom: 0.4rem;
  }

  .step__text {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
</style>
