---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AudienceSplit from '../../../components/AudienceSplit.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import EnquirySection from '../../../components/EnquirySection.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import Icon, { type IconName } from '../../../components/Icon.astro';
import NumberedGrid from '../../../components/NumberedGrid.astro';

import { ui } from '../../../i18n/ui';
import { localePaths, route, type Locale } from '../../../i18n/utils';
import { absRoute, breadcrumbSchema, faqSchema, serviceSchema } from '../../../lib/seo';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const page = t.itStaffing;

const schema = [
  breadcrumbSchema([
    { name: t.nav.home, url: absRoute(locale, 'home') },
    { name: t.nav.services, url: absRoute(locale, 'services') },
    { name: page.title, url: absRoute(locale, 'itStaffing') },
  ]),
  serviceSchema({
    locale,
    name: t.meta.itStaffing.title,
    description: t.meta.itStaffing.description,
    url: absRoute(locale, 'itStaffing'),
    serviceType: 'IT staff augmentation',
  }),
  faqSchema(page.faq),
];
---

<BaseLayout
  locale={locale}
  routeKey="itStaffing"
  title={t.meta.itStaffing.title}
  description={t.meta.itStaffing.description}
  schema={schema}
>
  {/* ─────────────────────────────────────────────────────────────  hero */}
  <section class="hero surface-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="glow glow--a" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <Breadcrumbs
          locale={locale}
          items={[
            { label: t.nav.home, href: route(locale, 'home') },
            { label: t.nav.services, href: route(locale, 'services') },
            { label: page.title },
          ]}
        />

        <p class="eyebrow">{page.eyebrow}</p>

        <h1 class="hero__title">
          {page.title}
          <span class="hero__native deva">{page.native}</span>
        </h1>

        <p class="lede hero__lede">{page.lede}</p>

        <div class="hero__actions">
          <a class="btn btn--lg hero__cta" href="#enquiry">
            {t.common.talkToUs}
            <Icon name="arrow-right" size={17} />
          </a>
          <a class="btn btn--outline btn--lg" href="#stack">
            {page.stackTitle}
          </a>
        </div>
      </div>

      <aside class="terminal" aria-hidden="true">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--r"></span>
          <span class="terminal__dot terminal__dot--y"></span>
          <span class="terminal__dot terminal__dot--g"></span>
          <span class="terminal__label">
            <Icon name="terminal" size={13} />
            engagement.sh
          </span>
        </div>
        <div class="terminal__body">
          <p><span class="terminal__prompt">$</span> rathore-tech scope --role="Senior Backend Engineer"</p>
          <p class="terminal__out">✓ stack matched: Node.js, PostgreSQL, AWS</p>
          <p class="terminal__out">✓ timezone overlap: 5h/day</p>
          <p><span class="terminal__prompt">$</span> rathore-tech shortlist --count=3</p>
          <p class="terminal__out">✓ 3 vetted profiles ready for interview</p>
          <p><span class="terminal__prompt">$</span> rathore-tech onboard --engagement=augmentation</p>
          <p class="terminal__out terminal__out--ok">✓ engineer onboarded — day 1 of sprint</p>
          <p class="terminal__cursor"><span class="terminal__prompt">$</span> <span class="blink">_</span></p>
        </div>
      </aside>
    </div>
  </section>

  {/* ──────────────────────────────────────────────────────  clients / talent */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.services.eyebrow}</p>
        <h2 class="h2">{t.nav.itStaffing}</h2>
      </div>

      <AudienceSplit
        columns={[
          { title: page.forClientsTitle, icon: 'server', points: page.forClients },
          { title: page.forTalentTitle, icon: 'users', points: page.forTalent },
        ]}
      />
    </div>
  </section>

  {/* ──────────────────────────────────────────────────────  engagement models */}
  <section class="section section--tight models surface-dark">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container models__inner">
      <div class="section-head">
        <p class="eyebrow">{page.modelsEyebrow}</p>
        <h2 class="h2">{page.modelsTitle}</h2>
        <p class="lede">{page.modelsSub}</p>
      </div>

      <div class="model-cards">
        {
          page.models.map((model, index) => (
            <article class="model-card reveal" style={`--reveal-delay:${index * 80}ms`}>
              <span class="card-icon model-card__icon">
                <Icon name={model.icon as IconName} size={22} />
              </span>
              <h3 class="model-card__title">{model.title}</h3>
              <p class="card__body">{model.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────────────────  tech stack */}
  <section class="section" id="stack">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{page.stackEyebrow}</p>
        <h2 class="h2">{page.stackTitle}</h2>
        <p class="lede">{page.stackSub}</p>
      </div>

      <div class="stack-grid">
        {
          page.stack.map((group, index) => (
            <div class="stack-group reveal" style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}>
              <h3 class="stack-group__title">{group.category}</h3>
              <ul class="stack-group__tags">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────────────────────  process */}
  <section class="section surface-dark process">
    <div class="grid-lines" aria-hidden="true"></div>

    <div class="container process__inner">
      <div class="section-head">
        <p class="eyebrow">{page.processEyebrow}</p>
        <h2 class="h2">{page.processTitle}</h2>
        <p class="lede">{page.processSub}</p>
      </div>

      <ol class="steps">
        {
          page.process.map((step, index) => (
            <li class="step reveal" style={`--reveal-delay:${index * 70}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ─────────────────────────────────────────────────────────────────  watch */}
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.services.eyebrow}</p>
        <h2 class="h2">{page.watchTitle}</h2>
      </div>

      <NumberedGrid items={page.watch} />
    </div>
  </section>

  {/* ────────────────────────────────────────────────────────────────  faq */}
  <section class="section section--tight faq-section">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">{t.home.faqEyebrow}</p>
        <h2 class="h2">{t.home.faqTitle}</h2>
      </div>

      <FAQAccordion items={page.faq} />
    </div>
  </section>

  <EnquirySection locale={locale} title={page.ctaTitle} body={page.ctaBody} defaultType="it" />

  <CTABand
    locale={locale}
    title={t.home.ctaTitle}
    body={page.ctaBody}
    waMessage={`${t.form.waIntro} — ${page.title}`}
  />
</BaseLayout>

<style>
  /* ────────────────────────────────────────────────────────────────  hero */

  .hero {
    position: relative;
    overflow: hidden;
  }

  .glow--a {
    width: 46rem;
    height: 28rem;
    top: -16rem;
    left: -10rem;
    background: radial-gradient(circle, rgb(46 139 107 / 0.4), transparent 68%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(4rem, 9vw, 6.5rem);
  }

  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: var(--fs-4xl);
    max-width: 18ch;
  }

  .hero__native {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.42em;
    font-weight: 500;
    color: var(--c-gold-400);
    opacity: 0.9;
  }

  .hero__lede {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__cta {
    background: var(--c-gold-500);
    color: var(--c-ink-900);
    box-shadow: 0 10px 34px -10px rgb(201 162 39 / 0.65);
  }

  .hero__cta:hover {
    background: var(--c-gold-400);
  }

  /* -------------------------------------------------------------- terminal */

  .terminal {
    padding: 0;
    overflow: hidden;
    background: #0b0f0d;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.65);
    font-family: var(--ff-mono);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: rgb(251 250 247 / 0.05);
    border-bottom: 1px solid var(--border);
  }

  .terminal__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(251 250 247 / 0.2);
  }

  .terminal__dot--r {
    background: #e5605a;
  }
  .terminal__dot--y {
    background: #e3b341;
  }
  .terminal__dot--g {
    background: #3fb567;
  }

  .terminal__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }

  .terminal__body {
    padding: 1.25rem 1.35rem 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.85;
  }

  .terminal__body p {
    white-space: pre-wrap;
    word-break: break-word;
    color: rgb(251 250 247 / 0.72);
  }

  .terminal__prompt {
    color: var(--c-gold-400);
  }

  .terminal__out {
    padding-left: 1.1rem;
    color: var(--c-forest-300);
  }

  .terminal__out--ok {
    color: var(--c-gold-300);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blink {
      animation: blink 1.1s step-end infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }

  /* ────────────────────────────────────────────────────────────── models */

  .models {
    position: relative;
    overflow: hidden;
  }

  .models__inner {
    position: relative;
    z-index: 1;
  }

  .model-cards {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 780px) {
    .model-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .model-card {
    padding: clamp(1.5rem, 2.6vw, 2rem);
    background: rgb(251 250 247 / 0.045);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .model-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }

  .model-card__icon {
    margin-bottom: 1rem;
  }

  .model-card__title {
    font-size: var(--fs-lg);
    margin-bottom: 0.5rem;
  }

  /* ─────────────────────────────────────────────────────────── tech stack */

  .stack-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .stack-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stack-group {
    padding: 1.5rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .stack-group__title {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .stack-group__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  /* ───────────────────────────────────────────────────────────── process */

  .process {
    position: relative;
    overflow: hidden;
  }

  .process__inner {
    position: relative;
    z-index: 1;
  }

  .steps {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
  }

  .step {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .step:first-child {
    border-top: none;
  }

  @media (min-width: 900px) {
    .step {
      flex-direction: column;
      gap: 1rem;
      padding: 2rem 1.5rem;
      border-top: none;
      background: var(--bg);
    }
  }

  .step__num {
    flex: none;
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-gold-400);
    padding-top: 0.15rem;
  }

  .step__title {
    font-size: var(--fs-base);
    margin-bottom: 0.4rem;
  }

  .step__text {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  /* -------------------------------------------------------------------faq */

  .faq-section {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }
</style>
